NEXT_PUBLIC_APPWRITE_PROJECT_ID= 
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/
NEXT_PUBLIC_APPWRITE_PROFILE_BUCKET_ID=

# Appwrite Cloud Database Configuration for Blog
NEXT_PUBLIC_APPWRITE_BLOG_DATABASE_ID=your_blog_database_id
NEXT_PUBLIC_APPWRITE_BLOG_COLLECTION_ID=posts

# Appwrite Blog Storage Bucket
NEXT_PUBLIC_APPWRITE_BLOG_BUCKET_ID=blog-images

# Admin Access Control (Appwrite Team ID or comma-separated user IDs / emails)
NEXT_PUBLIC_APPWRITE_ADMIN_TEAM_ID=your_admin_team_id
NEXT_PUBLIC_ADMIN_USER_IDS=your_admin_user_id
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# Optional Portfolio Content Collection
NEXT_PUBLIC_APPWRITE_PORTFOLIO_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_PORTFOLIO_COLLECTION_ID=

ALPHAVANTAGE_API_KEY=

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Secret token for on-demand revalidation (/api/refresh)
REVALIDATE_SECRET=
